          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Ticket",
        "tags": [
          "tickets"
        ],
        "x-implementation-status": "partial"
      }
    },
    "/health": {
      "get": {
        "description": "Checks this process only; does not probe DB, OAuth, mail or model providers.",
