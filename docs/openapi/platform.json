    "/api/v1/platform/evaluations/runs": {
      "post": {
        "description": "\uba85\uc2dc\uc801\uc73c\ub85c \ucf20 local/test \ud658\uacbd\uc758 \uc2b9\uc778\ub41c \ud569\uc131 smoke\ub9cc \uc800\uc7a5 \uc811\uc218\ud55c\ub2e4. \uc2e4\ud589\uae30\ub294 \ubbf8\uc5f0\uacb0\uc774\ub2e4.",
        "operationId": "platform_request_evaluation_run",
        "parameters": [
          {
            "in": "header",
