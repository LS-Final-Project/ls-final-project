  "info": {
    "description": "Process liveness only. Business routes are added by their owning service.",
    "title": "Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/platform/auth/callback": {
      "post": {
        "description": "Microsoft form_post\ub97c \uac80\uc99d\ud558\uace0 \uc0c8 \uc11c\ubc84 \uc138\uc158\uc744 \ubc1c\uae09\ud574 \uace0\uc815 \uc571 \uc9c4\uc785\uc810\uc73c\ub85c \uc774\ub3d9\ud55c\ub2e4.\n\nArgs:\n    request: \ube0c\ub77c\uc6b0\uc800 \uacb0\uc18d \ucfe0\ud0a4\uc640 form_post \ubcf8\ubb38\uc744 \ud3ec\ud568\ud55c \uc694\uccad.\n    provider: code \uad50\ud658\uacfc ID \ud1a0\ud070 \uac80\uc99d \uc5b4\ub311\ud130.\n\nReturns:\n    RedirectResponse: \uc138\uc158 \uad50\uccb4 \ud6c4 code\u00b7state \uc5c6\ub294 \uace0\uc815 URL\uc758 303 \uc751\ub2f5.",
        "operationId": "platform_complete_login",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "additionalProperties": {
                  "type": "string"
                },
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "303": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Callback",
        "tags": [
          "identity"
        ],
        "x-activation": "MICROSOFT_AUTH_ENABLED",
        "x-implementation-status": "draft"
      }
    },
    "/api/v1/platform/auth/login": {
      "get": {
        "description": "\uc11c\ubc84 \uc778\uac00 \uc2dc\ub3c4\ub97c \uc800\uc7a5\ud55c \ub4a4 Microsoft\ub85c \uc774\ub3d9\ud558\uace0 \ube0c\ub77c\uc6b0\uc800 \uacb0\uc18d \ucfe0\ud0a4\ub97c \uc124\uc815\ud55c\ub2e4.\n\nArgs:\n    request: \ub85c\uadf8\uc778 \uc2dc\uc791 \uc694\uccad.\n    provider: \uc11c\ubc84\uc758 Microsoft \ub85c\uadf8\uc778 \uc5b4\ub311\ud130.\n\nReturns:\n    RedirectResponse: flow\u00b7\ud1a0\ud070\uc744 \ud3ec\ud568\ud558\uc9c0 \uc54a\ub294 Microsoft \uc778\uac00 URL\uc758 302 \uc751\ub2f5.",
        "operationId": "platform_start_login",
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Login",
        "tags": [
          "identity"
        ],
        "x-activation": "MICROSOFT_AUTH_ENABLED",
        "x-implementation-status": "draft"
      }
    },
    "/api/v1/platform/auth/logout": {
      "post": {
        "description": "\ud5c8\uc6a9 Origin\uacfc \uc138\uc158 \uacb0\uc18d CSRF\ub97c \ud655\uc778\ud55c \ub4a4 \uc11c\ubc84 \uc138\uc158 \ucca0\ud68c\uc640 \ucfe0\ud0a4 \uc0ad\uc81c\ub97c \uc218\ud589\ud55c\ub2e4.\n\nArgs:\n    request: \uc6b4\uc601 \uc138\uc158 \ucfe0\ud0a4\u00b7Origin\u00b7X-CSRF-Token\uc744 \ud3ec\ud568\ud55c \uc694\uccad.\n\nReturns:\n    Response: \ucca0\ud68c\uac00 \uc644\ub8cc\ub41c 204 \uc751\ub2f5. \uc138\uc158 \ucfe0\ud0a4\uac00 \uc5c6\uc73c\uba74 \uac19\uc740 \uacb0\uacfc\ub97c \ubc18\ud658\ud55c\ub2e4.",
        "operationId": "platform_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Logout",
        "tags": [
          "identity"
        ],
        "x-activation": "MICROSOFT_AUTH_ENABLED",
        "x-implementation-status": "draft"
      }
    },
    "/api/v1/platform/health": {
      "get": {
        "description": "Checks this service process only; does not authorize business operations.",
        "operationId": "platform_health_api_v1_platform_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_HealthData_"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Platform Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/platform/me": {
      "get": {
        "description": "\uc6b4\uc601 \ub85c\uadf8\uc778 \ub610\ub294 \uba85\uc2dc\uc801 \uac1c\ubc1c \ubaa8\ub4dc\uc758 \ud604\uc7ac \uc0ac\uc6a9\uc790\ub97c \ubc18\ud658\ud55c\ub2e4.\n\nArgs:\n    request: \ud604\uc7ac \ud50c\ub7ab\ud3fc \uc694\uccad.\n    response: \uc6b4\uc601 \uc138\uc158 CSRF \ud5e4\ub354\ub97c \uc124\uc815\ud560 \uc751\ub2f5.\n\nReturns:\n    SuccessResponse[Identity]: DB\uc5d0\uc11c \uc870\ud68c\ud55c \ud604\uc7ac \uc0ac\uc6a9\uc790\uc640 \uc5ed\ud560.",
        "operationId": "platform_get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_Identity_"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-CSRF-Token": {
                "description": "Microsoft \uc11c\ubc84 \uc138\uc158\uc5d0 \uacb0\uc18d\ud55c \ubcc0\uacbd \uc694\uccad\uc6a9 \uac12. Identity \uacc4\uc57d\uc740 \uc720\uc9c0\ud55c\ub2e4.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Me",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/platform/ready": {
      "get": {
        "operationId": "platform_readiness_api_v1_platform_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_ReadinessData_"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Platform Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Checks this process only; does not probe DB, OAuth, mail or model providers.",
        "operationId": "process_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_HealthData_"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Process Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
