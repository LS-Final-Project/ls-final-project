{
  "components": {
    "schemas": {
      "ErrorData": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorData",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorData"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "error",
          "meta"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthData": {
        "properties": {
          "service": {
            "enum": [
              "cs",
              "tft",
              "platform"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "HealthData",
        "type": "object"
      },
      "Identity": {
        "properties": {
          "dept": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dept"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "oid": {
            "format": "uuid",
            "title": "Oid",
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "cs_agent",
                "dept_staff",
                "manager",
                "sales"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          },
          "tid": {
            "format": "uuid",
            "title": "Tid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "tid",
          "oid",
          "email",
          "display_name",
          "dept",
          "roles"
        ],
        "title": "Identity",
        "type": "object"
      },
      "ReadinessData": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "fts": {
            "title": "Fts",
            "type": "boolean"
          },
          "service": {
            "enum": [
              "cs",
              "tft",
              "platform"
            ],
            "title": "Service",
            "type": "string"
          },
          "vector": {
            "title": "Vector",
            "type": "boolean"
          }
        },
        "required": [
          "service",
          "database",
          "vector",
          "fts"
        ],
        "title": "ReadinessData",
        "type": "object"
      },
      "ResponseMeta": {
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "ResponseMeta",
        "type": "object"
      },
      "SuccessResponse_HealthData_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthData"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "SuccessResponse[HealthData]",
        "type": "object"
      },
      "SuccessResponse_Identity_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Identity"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "SuccessResponse[Identity]",
        "type": "object"
      },
      "SuccessResponse_ReadinessData_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReadinessData"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "SuccessResponse[ReadinessData]",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Process liveness only. Business routes are added by their owning service.",
    "title": "Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/platform/health": {
      "get": {
        "description": "Checks this service process only; does not authorize business operations.",
        "operationId": "platform_health_api_v1_platform_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_HealthData_"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Platform Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/platform/me": {
      "get": {
        "operationId": "platform_get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_Identity_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/platform/ready": {
      "get": {
        "operationId": "platform_readiness_api_v1_platform_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_ReadinessData_"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Platform Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Checks this process only; does not probe DB, OAuth, mail or model providers.",
        "operationId": "process_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_HealthData_"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Process Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
