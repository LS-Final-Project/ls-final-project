            "enum": [
              "cs",
              "tft",
              "platform"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "HealthData",
        "type": "object"
      },
      "Identity": {
        "properties": {
          "dept": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dept"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "oid": {
            "format": "uuid",
            "title": "Oid",
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "cs_agent",
                "dept_staff",
                "manager",
                "sales"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          },
          "tid": {
            "format": "uuid",
            "title": "Tid",
            "type": "string"
          }
        },
        "required": [
