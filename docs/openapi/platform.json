      "EvaluationPolicy": {
        "additionalProperties": false,
        "description": "\uc2e4\ud589 \uae30\ubc18 \uc5f0\uacb0 \uc804\uc5d0\ub294 \uc791\uc5c5\uacfc \ubbfc\uac10 \uc790\ub8cc \uc811\uadfc\uc744 \ud65c\uc131\ud654\ud558\uc9c0 \uc54a\ub294\ub2e4.",
