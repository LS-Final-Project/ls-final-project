          },
          "fts": {
            "title": "Fts",
            "type": "boolean"
          },
          "service": {
            "enum": [
              "cs",
              "tft",
              "platform"
            ],
            "title": "Service",
            "type": "string"
          },
          "vector": {
            "title": "Vector",
            "type": "boolean"
          }
        },
        "required": [
