{
  "name": "team4-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "test": "node --test server.test.mjs src/api/evaluations.test.ts",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "types:cs": "openapi-typescript ../docs/openapi/cs.json -o src/api/generated/cs.ts",
    "types:tft": "openapi-typescript ../docs/openapi/tft.json -o src/api/generated/tft.ts",
    "types:platform": "openapi-typescript ../docs/openapi/platform.json -o src/api/generated/platform.ts",
    "types": "npm run types:cs && npm run types:tft && npm run types:platform",
    "check": "npm run types && tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {"@tanstack/react-query": "^5.0.0", "react": "^19.0.0", "react-dom": "^19.0.0", "react-router-dom": "^7.18.4"},
  "devDependencies": {"@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "openapi-typescript": "^7.0.0", "typescript": "^5.0.0", "vite": "^7.0.0"}
}
