GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash

# GCP infrastructure CLI
LS_PROJECT_ID=proj-skkuls0106-183255377938
LS_GCP_ACCOUNT=skkuls0106@skkukdp.re.kr
LS_REGION=asia-northeast3

# Proposed local app database settings; set distinct passwords locally.
# Cloud Run uses Secret Manager for passwords.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=proj-skkuls0106-183255377938:asia-northeast3:team4-sql
DB_NAME=team4
CS_DB_USER=cs_app
CS_DB_PASSWORD=
TFT_DB_USER=tft_app
TFT_DB_PASSWORD=
PLATFORM_DB_USER=platform_app
PLATFORM_DB_PASSWORD=

# API process settings; Cloud Run containers use production.
ENVIRONMENT=local
DEV_AUTH_ENABLED=false
# LangSmith tracing (KAN-89): allowed only with ENVIRONMENT=local and AI_TRACING_ALLOWED=true.
# Other environments refuse to start when LANGSMITH_*/LANGCHAIN_* are set. Synthetic data only;
# the whole graph state (masked input, codes, attempts) is sent. See docs/decisions.md.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ls-final-cs-local
AI_TRACING_ALLOWED=false
SERVICE_NAME=cs
PORT=8080
# C/S vector search (KAN-99/100). Code default is off; local and demo turn it on.
# Needs migration C20 (cs/20261103_KAN-99_chunk_embeddings.sql) and `scripts/cs_index_docs.py --embed` first.
# Without embeddings, or when an embedding/DB call fails, search falls back to FTS and logs CS_VECTOR_SEARCH_FAILED.
# Run VACUUM cs.chunk_embeddings after re-indexing.
# Applied only when exported to the process environment (set -a; . ./.env; set +a), same as AISettings/GEMINI_API_KEY.
CS_VECTOR_SEARCH_ENABLED=true
CS_EMBEDDING_MODEL=gemini-embedding-2
CS_EMBEDDING_DIMENSION=768
CS_EMBEDDING_QUERY_TASK_TYPE=RETRIEVAL_DOCUMENT
